    <!-- Nội dung mô tả kịch bản mẫu:跟随界面语言，用户改过则以用户文本为准 -->
    <string name="rt_scene_general_instruction">Phù hợp cho hội thoại hàng ngày và giao tiếp tại chỗ thông thường. Ưu tiên độ chính xác về ý nghĩa và cách diễn đạt tự nhiên, tránh giọng văn cứng nhắc.</string>
    <string name="rt_scene_meeting_instruction">Đây là cuộc họp hoặc thảo luận kinh doanh. Xử lý chính xác các chủ đề, kết luận, số liệu, trách nhiệm và các đầu việc cần làm; duy trì phong cách chuyên nghiệp, súc tích.</string>
    <string name="rt_scene_classroom_instruction">Đây là lớp học hoặc bài giảng. Giữ nguyên thuật ngữ chuyên ngành, định nghĩa, ví dụ và chuỗi lập luận để bản dịch dễ theo dõi bài giảng.</string>
    <string name="rt_scene_interview_instruction">Đây là buổi phỏng vấn. Tách biệt rõ câu hỏi và câu trả lời, giữ nguyên ngữ điệu, quan điểm và từ ngữ của từng người nói, không tự ý trau chuốt lập trường của họ.</string>
    <string name="rt_scene_travel_instruction">Đây là giao tiếp tại chỗ khi du lịch. Ưu tiên độ chính xác về địa điểm, thời gian, giá cả, lộ trình, quy tắc và các câu giao tiếp lịch sự.</string>
    <string name="rt_scene_general_video_instruction">Phù hợp cho nội dung video nói chung. Duy trì phụ đề liền mạch, xử lý chính xác tiêu đề, nhân vật, tổ chức và các từ khóa chủ đề.</string>
    <string name="rt_scene_livestream_instruction">Đây là buổi phát trực tiếp. Thích ứng với khẩu ngữ, câu rút gọn, tương tác và chuyển chủ đề nhanh; dịch bình luận chat và danh xưng khán giả tự nhiên theo ngữ cảnh.</string>
    <string name="rt_scene_vtuber_instruction">Đây là buổi phát trực tiếp của VTuber. Ưu tiên cách dịch phổ biến trong cộng đồng cho tên nhân vật, tên nhóm và thuật ngữ streaming; giữ nguyên danh từ riêng chưa chắc chắn.</string>
    <string name="rt_scene_anime_instruction">Đây là nội dung anime. Giữ đúng giọng điệu nhân vật và cách xưng hô; ưu tiên bản dịch quen thuộc cho tên tác phẩm, tên nhân vật, chiêu thức và thiết lập cốt truyện.</string>
    <string name="rt_scene_game_instruction">Đây là nội dung game. Xử lý chính xác tên game, nhân vật, kỹ năng, vật phẩm, bản đồ và cơ chế trò chơi; giữ nhịp điệu khẩu ngữ tự nhiên của game thủ.</string>
    <string name="rt_scene_news_instruction">Đây là nội dung thời sự, tin tức. Duy trì tính khách quan và mật độ thông tin cao; dịch chính xác tên người, địa danh, tổ chức, số liệu, ngày tháng và các câu trích dẫn.</string>
    <string name="rt_scene_course_instruction">Đây là khóa học hoặc video hướng dẫn thực hành. Giữ nguyên thuật ngữ kỹ thuật, các bước thao tác, định nghĩa và quan hệ nhân quả; diễn đạt rõ ràng mà không thêm thắt suy đoán.</string>
